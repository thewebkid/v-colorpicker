{
  "name": "v-cpicker",
  "version": "2.0.2",
  "private": false,
  "author": "Ron Gilchrist (thewebkid)",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "javascript",
    "colorpicker",
    "color-picker"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "main": "./dist/v-cpicker.umd.cjs",
  "module": "./dist/v-cpicker.js",
  "exports": {
    ".": {
      "import": "./dist/v-cpicker.js",
      "require": "./dist/v-cpicker.umd.cjs"
    },
    "./style.css": "./dist/v-cpicker.css"
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thewebkid/v-colorpicker.git"
  },
  "homepage": "https://thewebkid.com/modules/v-cpicker",
  "dependencies": {
    "modern-color": "^1.4.1",
    "v-movable": "^1.0.2",
    "v-range-flyout": "^2.0.1"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sass": "^1.69.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  }
}
